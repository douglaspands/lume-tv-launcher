{
  "zsh-safe-execution-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/validate-safe-command.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
