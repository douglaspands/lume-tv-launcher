<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <!-- A normal permission, granted at install: since Android 9 the system uninstaller opens only
         for apps that hold it. Used only when the user picks "Uninstall" in a context menu. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- A normal permission, granted at install: Android lets an app open a socket only with it, and
         a socket is the only way left to list the network interfaces (the TV information screen's
         connection and address). Lume never opens a connection. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- App visibility through intent queries; no QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Android 11 hides the TV inputs panel from resolveActivity without this. -->
        <intent>
            <action android:name="com.android.tv.action.VIEW_INPUTS" />
        </intent>
        <!-- Android 11 also hides the settings screens from resolveActivity, so every settings
             shortcut found only the general settings. These are the settings apps of the TVs (and
             the one with the default home app screen), and the stub some firmwares answer with when
             no app does the action (which is skipped). -->
        <package android:name="com.android.tv.settings" />
        <package android:name="com.android.settings" />
        <package android:name="com.google.android.permissioncontroller" />
        <package android:name="com.google.android.tv.frameworkpackagestubs" />
    </queries>

    <application
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:hasCode="true"
        android:allowBackup="false"
        android:theme="@style/LumeTheme">

        <activity
            android:name=".LumeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|density|uiMode|locale|layoutDirection|navigation"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">

            <meta-data
                android:name="android.app.lib_name"
                android:value="lume" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
