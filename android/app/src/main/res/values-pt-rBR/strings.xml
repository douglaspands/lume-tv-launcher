    <!-- Tools: display and picture -->
    <string name="tool_display_diagnostic">Diagnóstico</string>
    <string name="tool_display_diagnostic_desc">Padrões de tela cheia para encontrar pixels mortos ou presos, manchas, vazamento de luz e falhas do backlight. Esquerda e Direita trocam o padrão. Eles só diagnosticam: pixel morto, linhas e defeitos do backlight não têm conserto por software.</string>
    <string name="tool_display_clean">Limpar retenção</string>
    <string name="tool_display_clean_desc">Mostra cores em tela cheia, devagar, para remover imagem fantasma temporária (retenção). Não conserta marcas permanentes, pixel morto nem defeitos do backlight.</string>
    <string name="tool_display_fix">Destravar pixel</string>
    <string name="tool_display_fix_desc">Pisca cores rapidamente numa janela pequena sobre um pixel preso aceso. Às vezes resolve; um pixel morto (sempre preto) não tem conserto por software.</string>
    <string name="tool_display_duration">Duração: %1$d min</string>
    <string name="tool_display_pattern">Padrão: %1$s</string>
    <string name="tool_display_colors">Cores</string>
    <string name="tool_display_place">Posicionar a janela</string>
    <string name="tool_display_place_hint">Setas movem a janela, OK confirma</string>
    <string name="tool_display_clean_done">Limpeza concluída</string>
    <string name="tool_display_fix_done">Destravamento concluído</string>
    <string name="tool_display_black">Preto</string>
    <string name="tool_display_white">Branco</string>
    <string name="tool_display_red">Vermelho</string>
    <string name="tool_display_green">Verde</string>
    <string name="tool_display_blue">Azul</string>
    <string name="tool_display_gray">Cinza %1$d%%</string>
    <string name="tool_display_gray_ramp">Rampa de cinza</string>
    <string name="tool_display_red_ramp">Rampa de vermelho</string>
    <string name="tool_display_green_ramp">Rampa de verde</string>
    <string name="tool_display_blue_ramp">Rampa de azul</string>
    <string name="tool_display_grid">Grade</string>
    <string name="tool_picture_overscan">Overscan e geometria</string>
    <string name="tool_picture_overscan_desc">Uma borda de 1 pixel no limite exato da imagem e marcas a 2,5%% (amarela) e 5%% (azul) de cada lado mostram quanto a TV corta. O círculo central deve parecer redondo, e o quadrado, ter os lados iguais.</string>
    <string name="tool_picture_overscan_hint">Borda: limite da imagem · amarela: 2,5%% · azul: 5%%</string>
    <string name="tool_picture_motion">Movimento</string>
    <string name="tool_picture_motion_desc">Um bloco e um texto atravessam a tela em velocidade constante, para mostrar borrão, rastro e trancos. Cima e Baixo mudam a velocidade. O contador mostra os quadros perdidos (33 ms ou mais), inclusive os causados pelo próprio Lume.</string>
    <string name="tool_picture_motion_sample">Texto em movimento</string>
    <string name="tool_picture_speed_slow">Lenta</string>
    <string name="tool_picture_speed_medium">Média</string>
    <string name="tool_picture_speed_fast">Rápida</string>
    <string name="tool_picture_motion_status">Velocidade: %1$s · Quadros perdidos: %2$d</string>
