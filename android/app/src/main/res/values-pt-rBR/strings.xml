    <string name="tool_audio_right">Direito</string>
    <string name="tool_audio_both">Os dois</string>
    <string name="tool_audio_sweep">Varredura</string>
    <string name="tool_audio_sync">Sincronia</string>
    <string name="tool_audio_left_desc">Um tom de 440 Hz só no alto-falante esquerdo. Se ele sair do direito, os canais estão trocados.</string>
    <string name="tool_audio_right_desc">Um tom de 440 Hz só no alto-falante direito. Se ele sair do esquerdo, os canais estão trocados.</string>
    <string name="tool_audio_both_desc">Um tom de 440 Hz nos dois alto-falantes, para comparar o volume deles.</string>
    <string name="tool_audio_sweep_desc">Um tom que sobe de 20 Hz a 20 kHz em 30 segundos. Anote a frequência em que o alto-falante chia, vibra ou some.</string>
    <string name="tool_audio_sync_desc">Um bipe e um quadrado branco a cada segundo. Ajuste com Esquerda e Direita até parecerem juntos e corrija o atraso no menu de som da TV.</string>
