    <!-- Tools: display and picture -->
    <string name="tool_display_diagnostic">Diagnóstico</string>
    <string name="tool_display_diagnostic_desc">Patrones a pantalla completa para encontrar píxeles muertos o atascados, manchas, fugas de luz y fallos de la retroiluminación. Izquierda y Derecha cambian el patrón. Solo diagnostican: los píxeles muertos, las líneas y los fallos de la retroiluminación no se arreglan por software.</string>
    <string name="tool_display_clean">Limpiar retención</string>
    <string name="tool_display_clean_desc">Muestra colores a pantalla completa, despacio, para quitar una imagen fantasma temporal (retención). No arregla marcas permanentes, píxeles muertos ni fallos de la retroiluminación.</string>
    <string name="tool_display_fix">Desatascar píxel</string>
    <string name="tool_display_fix_desc">Hace parpadear colores rápidamente en una ventana pequeña sobre un píxel atascado encendido. A veces funciona; un píxel muerto (siempre negro) no se arregla por software.</string>
    <string name="tool_display_duration">Duración: %1$d min</string>
    <string name="tool_display_pattern">Patrón: %1$s</string>
    <string name="tool_display_colors">Colores</string>
    <string name="tool_display_place">Colocar la ventana</string>
    <string name="tool_display_place_hint">Las flechas mueven la ventana, OK confirma</string>
    <string name="tool_display_clean_done">Limpieza terminada</string>
    <string name="tool_display_fix_done">Desatasco terminado</string>
    <string name="tool_display_black">Negro</string>
