    <string name="tool_audio_sync">Sync</string>
    <string name="tool_audio_left_desc">A 440 Hz tone on the left speaker only. If it comes from the right one, the channels are swapped.</string>
    <string name="tool_audio_right_desc">A 440 Hz tone on the right speaker only. If it comes from the left one, the channels are swapped.</string>
    <string name="tool_audio_both_desc">A 440 Hz tone on both speakers, to compare their volume.</string>
    <string name="tool_audio_sweep_desc">A tone rising from 20 Hz to 20 kHz in 30 seconds. Note the frequency where the speaker buzzes, rattles or fades out.</string>
    <string name="tool_audio_sync_desc">A beep and a white square every second. Adjust with Left and Right until they seem together, then fix the delay in the sound menu of the TV.</string>
