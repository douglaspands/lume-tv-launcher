    <!-- Tools: display and picture -->
    <string name="tool_display_diagnostic">Diagnostics</string>
    <string name="tool_display_diagnostic_desc">Full-screen patterns to find dead or stuck pixels, blotches, light bleed and backlight faults. Left and Right change the pattern. They only diagnose: dead pixels, lines and backlight faults cannot be fixed by software.</string>
    <string name="tool_display_clean">Clear retention</string>
    <string name="tool_display_clean_desc">Slowly shows full-screen colors to remove a temporary ghost image (image retention). It does not fix permanent burn-in, dead pixels or backlight faults.</string>
    <string name="tool_display_fix">Unstick pixel</string>
    <string name="tool_display_fix_desc">Flashes colors quickly in a small window over a stuck pixel that stays lit. Sometimes it works; a dead pixel (always black) cannot be fixed by software.</string>
