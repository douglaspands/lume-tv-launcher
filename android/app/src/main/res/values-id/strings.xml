    <!-- Tools: display and picture -->
    <string name="tool_display_diagnostic">Diagnostik</string>
    <string name="tool_display_diagnostic_desc">Pola layar penuh untuk menemukan piksel mati atau macet, noda, kebocoran cahaya, dan kerusakan lampu latar. Kiri dan Kanan mengganti pola. Pola ini hanya untuk diagnosis: piksel mati, garis, dan kerusakan lampu latar tidak bisa diperbaiki dengan perangkat lunak.</string>
    <string name="tool_display_clean">Hapus retensi</string>
    <string name="tool_display_clean_desc">Menampilkan warna layar penuh secara perlahan untuk menghapus bayangan gambar sementara (retensi). Tidak memperbaiki bekas permanen, piksel mati, atau kerusakan lampu latar.</string>
    <string name="tool_display_fix">Pulihkan piksel macet</string>
    <string name="tool_display_fix_desc">Mengedipkan warna dengan cepat di jendela kecil di atas piksel macet yang selalu menyala. Kadang berhasil; piksel mati (selalu hitam) tidak bisa diperbaiki dengan perangkat lunak.</string>
    <string name="tool_display_duration">Durasi: %1$d mnt</string>
    <string name="tool_display_pattern">Pola: %1$s</string>
    <string name="tool_display_colors">Warna</string>
    <string name="tool_display_place">Atur posisi jendela</string>
    <string name="tool_display_place_hint">Panah menggeser jendela, OK mengonfirmasi</string>
    <string name="tool_display_clean_done">Pembersihan selesai</string>
    <string name="tool_display_fix_done">Pemulihan selesai</string>
    <string name="tool_display_black">Hitam</string>
    <string name="tool_display_white">Putih</string>
    <string name="tool_display_red">Merah</string>
    <string name="tool_display_green">Hijau</string>
    <string name="tool_display_blue">Biru</string>
    <string name="tool_display_gray">Abu-abu %1$d%%</string>
    <string name="tool_display_gray_ramp">Gradasi abu-abu</string>
    <string name="tool_display_red_ramp">Gradasi merah</string>
    <string name="tool_display_green_ramp">Gradasi hijau</string>
    <string name="tool_display_blue_ramp">Gradasi biru</string>
    <string name="tool_display_grid">Kisi</string>
    <string name="tool_picture_overscan">Overscan dan geometri</string>
    <string name="tool_picture_overscan_desc">Bingkai 1 piksel tepat di tepi gambar serta tanda 2,5%% (kuning) dan 5%% (biru) dari tiap sisi menunjukkan seberapa banyak TV memotong gambar. Lingkaran di tengah harus tampak bulat, dan sisi persegi harus sama panjang.</string>
    <string name="tool_picture_overscan_hint">Bingkai: tepi gambar · kuning: 2,5%% · biru: 5%%</string>
    <string name="tool_picture_motion">Gerakan</string>
    <string name="tool_picture_motion_desc">Sebuah blok dan teks melintasi layar dengan kecepatan tetap untuk menunjukkan buram, jejak, dan patah-patah. Atas dan Bawah mengubah kecepatan. Penghitung menunjukkan frame yang hilang (33 ms atau lebih), termasuk yang disebabkan oleh Lume sendiri.</string>
    <string name="tool_picture_motion_sample">Teks bergerak</string>
    <string name="tool_picture_speed_slow">Lambat</string>
    <string name="tool_picture_speed_medium">Sedang</string>
    <string name="tool_picture_speed_fast">Cepat</string>
