    <!-- Tools: display and picture -->
    <string name="tool_display_diagnostic">Диагностика</string>
    <string name="tool_display_diagnostic_desc">Полноэкранные шаблоны для поиска мёртвых и застрявших пикселей, пятен, засветов и неисправностей подсветки. Влево и Вправо меняют шаблон. Это только диагностика: мёртвые пиксели, полосы и неисправности подсветки программой не исправить.</string>
    <string name="tool_display_clean">Убрать остаточное изображение</string>
    <string name="tool_display_clean_desc">Медленно показывает цвета на весь экран, чтобы убрать временное остаточное изображение. Не исправляет постоянное выгорание, мёртвые пиксели и неисправности подсветки.</string>
    <string name="tool_display_fix">Оживить пиксель</string>
    <string name="tool_display_fix_desc">Быстро мигает цветами в маленьком окне над застрявшим светящимся пикселем. Иногда помогает; мёртвый пиксель (всегда чёрный) программой не исправить.</string>
    <string name="tool_display_duration">Длительность: %1$d мин</string>
    <string name="tool_display_pattern">Шаблон: %1$s</string>
    <string name="tool_display_colors">Цвета</string>
    <string name="tool_display_place">Разместить окно</string>
